@startuml "Content Scraper Flow - Temporal Best Practices"

' Actors
actor User
actor "Scheduled Job" as Job

' Components
box "Frontend" #LightBlue
  participant "Parser Config UI" as UI
  participant "API Service" as APIService
end box

box "Backend" #LightYellow
  participant "Parser Config Controller" as Controller
  participant "Parser Config Service" as ConfigService
  participant "News Strategy Manager" as StrategyManager
  participant "Configurable Parser Strategy" as ConfigurableStrategy
  participant "Collector Service" as CollectorService
  database "Database" as DB
end box

box "Temporal Infrastructure - Hierarchical Design" #LightGreen
  participant "Temporal Client" as TemporalClient
  participant "Temporal Workflow Engine" as WorkflowEngine

  box "Task Queues" #PaleGreen
    participant "Daily Aggregation Queue" as DailyQueue
    participant "Source Collection Queue" as SourceQueue
    participant "Article Processing Queue" as ArticleQueue
  end box

  box "Level 1: Orchestrator" #LightCyan
    participant "Daily Aggregation Workflow" as DailyWorkflow
  end box

  box "Level 2: Source Processing" #LightSalmon
    participant "Source Collection Workflow" as SourceWorkflow
  end box

  box "Level 3: Article Processing" #LightYellow
    participant "Article Processing Workflow" as ArticleWorkflow
  end box

  box "Activities by Domain" #Lavender
    participant "Feed Activity" as FeedActivity
    participant "Content Activity" as ContentActivity
    participant "Data Activity" as DataActivity
    participant "Analytics Activity" as AnalyticsActivity
  end box
end box

' Parser Configuration Flow
group "Parser Configuration Flow"
  User -> UI: Open parser configuration page
  UI -> APIService: Load existing parsers
  APIService -> Controller: GET /api/parser-configs
  Controller -> ConfigService: getAllConfigs()
  ConfigService -> DB: Query parser_configs table
  DB --> ConfigService: Return config records
  ConfigService --> Controller: Return config list
  Controller --> APIService: Return config data
  APIService --> UI: Display existing parsers

  User -> UI: Create new parser or edit existing
  User -> UI: Enter test URL and selectors
  UI -> APIService: Test parser with URL
  APIService -> Controller: POST /api/parser-configs/test
  Controller -> ConfigService: testParser(url, config)
  ConfigService -> ConfigurableStrategy: create(config)
  ConfigService -> ConfigurableStrategy: parse(document)
  ConfigurableStrategy --> ConfigService: Return parsing result
  ConfigService --> Controller: Return test results
  Controller --> APIService: Return result data
  APIService --> UI: Display extracted content/author

  User -> UI: Save parser configuration
  UI -> APIService: Save parser config
  APIService -> Controller: POST /api/parser-configs
  Controller -> ConfigService: saveConfig(config)
  ConfigService -> DB: Save to parser_configs table
  ConfigService -> StrategyManager: addOrUpdateConfig(config)
  StrategyManager -> StrategyManager: Update config cache
  ConfigService --> Controller: Return saved config
  Controller --> APIService: Return saved config
  APIService --> UI: Show success message
end

' Hierarchical Content Scraping Flow with Temporal
group "Hierarchical Content Scraping Flow"
  Job -> CollectorService: Trigger daily aggregation
  CollectorService -> TemporalClient: Start Daily Aggregation Workflow
  TemporalClient -> WorkflowEngine: Execute workflow
  WorkflowEngine -> DailyWorkflow: Run daily aggregation

  DailyWorkflow -> DataActivity: Get all active sources
  DataActivity -> DB: Query active sources
  DB --> DataActivity: Return source list
  DataActivity --> DailyWorkflow: Return sources

  note right of DailyWorkflow
    Parent workflow spawns child workflows
    for each source in parallel (30+ sources)
  end note

  loop for each source (parallel execution)
    DailyWorkflow -> WorkflowEngine: Spawn Source Collection Workflow
    WorkflowEngine -> SourceWorkflow: Process single source

    SourceWorkflow -> FeedActivity: Fetch RSS feed
    FeedActivity -> StrategyManager: Get RSS parser
    StrategyManager --> FeedActivity: Return RSS strategy
    FeedActivity --> SourceWorkflow: Return feed content

    SourceWorkflow -> FeedActivity: Extract article URLs
    FeedActivity --> SourceWorkflow: Return article list

    SourceWorkflow -> DataActivity: Check existing articles
    DataActivity -> DB: Query existing URLs
    DB --> DataActivity: Return existing articles
    DataActivity --> SourceWorkflow: Return new articles only

    SourceWorkflow -> DataActivity: Save new articles
    DataActivity -> DB: Insert new article records
    DataActivity --> SourceWorkflow: Return saved article IDs

    note right of SourceWorkflow
      Source workflow spawns child workflows
      for each new article (parallel processing)
    end note

    loop for each new article (parallel execution)
      SourceWorkflow -> WorkflowEngine: Spawn Article Processing Workflow
      WorkflowEngine -> ArticleWorkflow: Process single article

      ArticleWorkflow -> ContentActivity: Parse article content
      ContentActivity -> StrategyManager: Get parsing strategy
      StrategyManager --> ContentActivity: Return parser strategy
      ContentActivity -> ConfigurableStrategy: Parse document
      ConfigurableStrategy --> ContentActivity: Return parsed content

      alt Multi-page article detected
        ContentActivity -> ContentActivity: Process additional pages
        loop while next page exists
          ContentActivity -> ConfigurableStrategy: Parse next page
          ConfigurableStrategy --> ContentActivity: Return page content
        end
        ContentActivity -> ContentActivity: Combine all pages
      end

      ContentActivity --> ArticleWorkflow: Return final content

      ArticleWorkflow -> DataActivity: Save article content
      DataActivity -> DB: Update article with content
      DataActivity --> ArticleWorkflow: Confirm save

      ArticleWorkflow -> AnalyticsActivity: Update article metrics
      AnalyticsActivity -> DB: Update word count, reading time
      AnalyticsActivity --> ArticleWorkflow: Confirm metrics

      alt Processing failed
        ArticleWorkflow -> WorkflowEngine: Apply retry policy
        note right
          Temporal handles:
          - Exponential backoff per article
          - Different retry strategies by error type
          - Dead letter handling for failed articles
        end note
      end

      ArticleWorkflow --> SourceWorkflow: Return processing result
    end

    SourceWorkflow -> DataActivity: Update source last scraped
    DataActivity -> DB: Update source timestamp
    DataActivity --> SourceWorkflow: Confirm update

    SourceWorkflow --> DailyWorkflow: Return source results
  end

  DailyWorkflow -> AnalyticsActivity: Generate aggregation summary
  AnalyticsActivity -> DB: Calculate total metrics
  AnalyticsActivity --> DailyWorkflow: Return summary

  DailyWorkflow --> CollectorService: Return aggregation results
  CollectorService --> Job: Complete with statistics
end

' User-triggered scraping with Temporal
group "Manual Scraping Flow"
  User -> UI: Click "Run Scraper" button
  UI -> APIService: Trigger scraping
  APIService -> Controller: POST /api/scraper/run
  Controller -> CollectorService: start()
  note right
    This follows the same Temporal workflow
    flow as the scheduled job above
  end note
  CollectorService --> Controller: Return workflow execution IDs
  Controller --> APIService: Return workflow status
  APIService --> UI: Show scraping statistics and workflow progress
end

' Retry Processing Flow with Temporal
group "Retry Processing Flow"
  User -> UI: Click "Retry Failed Articles" button
  UI -> APIService: Trigger retry processing
  APIService -> Controller: POST /api/scraper/re-run
  Controller -> CollectorService: retryPendingArticles()
  CollectorService -> DB: Find failed/pending articles
  DB --> CollectorService: Return article list

  loop for each failed article
    CollectorService -> TemporalClient: Start Article Processing Workflow
    TemporalClient -> WorkflowEngine: Execute retry workflow
    WorkflowEngine -> ProcessingWorkflow: Execute with retry policy
    note right
      Temporal applies intelligent retry policies:
      - Exponential backoff
      - Different strategies for network vs parsing errors
      - Maximum retry limits with dead letter handling
    end note
  end

  CollectorService --> Controller: Return retry results
  Controller --> APIService: Return retry statistics
  APIService --> UI: Show retry progress and results
end

' Temporal Monitoring and Observability
group "Temporal Monitoring"
  User -> UI: Access workflow monitoring
  UI -> APIService: Request workflow status
  APIService -> TemporalClient: Query workflow executions
  TemporalClient -> WorkflowEngine: Get workflow status
  WorkflowEngine --> TemporalClient: Return execution details
  TemporalClient --> APIService: Return workflow information
  APIService --> UI: Display workflow progress, retries, and errors
end

@enduml